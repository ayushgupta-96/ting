PROJECT_NAME="Toing Platform"
API_V1_STR="/api/v1"
SECRET_KEY="supersecretjwtkey_change_me_in_production"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Toing Target API
TOING_BASE_URL="https://storelex.store/toing_web"
DEFAULT_USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/157.0.0.0 Safari/537.36 Edg/157.0.0.0"

# Server Port
PORT=8001
HOST="0.0.0.0"

# Telegram Bot
BOT_TOKEN="your_bot_token_here"
MINI_APP_URL="https://your-domain-or-ngrok.com"

# Storage
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/toing_db"
REDIS_URL="redis://localhost:6379/0"
